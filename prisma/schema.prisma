// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Our database models will go here later
// ... (generator and datasource blocks remain the same) ...

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String? // The '?' makes this field optional
  lastName  String? // The '?' makes this field optional

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}